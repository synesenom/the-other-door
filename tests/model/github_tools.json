{
  "_comment": "The GitHub MCP server's tools that .claude/ names, with every parameter and the allowed values of the enum ones (`method`, `merge_method`, `state_reason`). Pinned by hand from the server's tool schemas (list its tools, copy each named tool's inputSchema.properties and enums); add a tool here when a skill or agent starts naming it. Checked by tests/model/test_skill_contract_unit.py, offline.",
  "add_issue_comment": {"params": ["owner", "repo", "issue_number", "body", "comment_id", "reaction"]},
  "create_pull_request": {"params": ["owner", "repo", "title", "body", "head", "base", "draft", "maintainer_can_modify", "reviewers"]},
  "issue_read": {"params": ["method", "owner", "repo", "issue_number", "page", "perPage"], "values": {"method": ["get", "get_comments", "get_sub_issues", "get_labels", "get_parent"]}},
  "issue_write": {"params": ["method", "owner", "repo", "issue_number", "title", "body", "assignees", "labels", "milestone", "type", "state", "state_reason", "duplicate_of", "issue_fields", "parent_issue_number", "parent_owner", "parent_repo"], "values": {"method": ["create", "update"], "state_reason": ["completed", "not_planned", "duplicate"]}},
  "list_issues": {"params": ["owner", "repo", "state", "labels", "orderBy", "direction", "since", "after", "perPage", "field_filters", "fields"]},
  "merge_pull_request": {"params": ["owner", "repo", "pullNumber", "commit_title", "commit_message", "merge_method", "expectedHeadSha"], "values": {"merge_method": ["merge", "squash", "rebase"]}},
  "pull_request_read": {"params": ["method", "owner", "repo", "pullNumber", "page", "perPage", "after"], "values": {"method": ["get", "get_diff", "get_status", "get_files", "get_commits", "get_review_comments", "get_reviews", "get_comments", "get_check_runs"]}},
  "search_issues": {"params": ["query", "owner", "repo", "sort", "order", "page", "perPage", "fields"]},
  "sub_issue_write": {"params": ["method", "owner", "repo", "issue_number", "sub_issue_id", "replace_parent", "after_id", "before_id"], "values": {"method": ["add", "remove", "reprioritize"]}},
