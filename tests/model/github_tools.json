{
  "_comment": "The GitHub MCP server's tools that .claude/ names, with every parameter and, for method-style tools, the allowed methods. Pinned by hand from the server's tool schemas (list its tools, copy each named tool's inputSchema.properties and the enum of `method`); add a tool here when a skill or agent starts naming it. Checked by tests/model/test_skill_contract_unit.py, offline.",
  "add_issue_comment": {"params": ["owner", "repo", "issue_number", "body"]},
  "create_pull_request": {"params": ["owner", "repo", "title", "body", "head", "base", "draft", "maintainer_can_modify"]},
  "issue_read": {"params": ["method", "owner", "repo", "issue_number", "page", "perPage"], "methods": ["get", "get_comments", "get_sub_issues", "get_labels"]},
  "issue_write": {"params": ["method", "owner", "repo", "issue_number", "title", "body", "assignees", "labels", "milestone", "type", "state", "state_reason", "duplicate_of"], "methods": ["create", "update"]},
  "list_issues": {"params": ["owner", "repo", "state", "labels", "orderBy", "direction", "since", "after", "perPage"]},
  "merge_pull_request": {"params": ["owner", "repo", "pullNumber", "commit_title", "commit_message", "merge_method"]},
  "pull_request_read": {"params": ["method", "owner", "repo", "pullNumber", "page", "perPage"], "methods": ["get", "get_diff", "get_status", "get_files", "get_review_comments", "get_reviews", "get_comments", "get_check_runs"]},
  "search_issues": {"params": ["query", "owner", "repo", "sort", "order", "page", "perPage"]},
  "sub_issue_write": {"params": ["method", "owner", "repo", "issue_number", "sub_issue_id", "replace_parent", "after_id", "before_id"], "methods": ["add", "remove", "reprioritize"]},
  "subscribe_pr_activity": {"params": ["owner", "repo", "pullNumber"]},
  "unsubscribe_pr_activity": {"params": ["owner", "repo", "pullNumber"]}
}
