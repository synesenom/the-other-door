{
  "$description": "door's visual design tokens, for the desktop app (#215) and the phone app (#303). docs/design/README.md explains each one. Colours were checked for WCAG contrast; the ratios are in the README.",
  "color": {
    "light": {
      "ground":      { "value": "#F1E6CF", "use": "window background (the logo's parchment)" },
      "surface":     { "value": "#F8F1E2", "use": "selected row, chips, cards" },
      "page":        { "value": "#FFFCF5", "use": "document previews, text inputs" },
      "ink":         { "value": "#1E1A16", "use": "text, primary buttons, the logo" },
      "ink-muted":   { "value": "#6B6157", "use": "secondary text, labels" },
      "border":      { "value": "#D6C7A8", "use": "every line: hairlines between parts and rows, card, button and input borders" },
      "accent":      { "value": "#2F55C8", "use": "the one blue: links and blue words, the dash, progress; never a button fill" },
      "success":     { "value": "#3F6B4F", "use": "the circle of a done step or connection, the check of a board or source read; marks only" },
      "danger":      { "value": "#B3261E", "use": "the cross of a board or source that failed; small marks only" },
      "warning":     { "value": "#E8C04F", "use": "the triangle before a line that needs you; marks only" },
      "on-warning":  { "value": "#1E1A16", "use": "the ! on that triangle: dark in both themes, set once" },
      "scrim":       { "value": "rgba(30,26,22,0.4)", "use": "the veil behind a dialog" },
      "accent-tint": { "value": "rgba(47,85,200,0.14)", "use": "the accent, faint, behind text: the lines just added to the CV" }
    },
    "dark": {
      "ground":      { "value": "#1E1A16" },
      "surface":     { "value": "#2A2520" },
      "page":        { "value": "#36302A" },
      "ink":         { "value": "#F1E6CF" },
      "ink-muted":   { "value": "#A59A85" },
      "border":      { "value": "#4A423A" },
      "accent":      { "value": "#86A0F2" },
      "success":     { "value": "#7FA37E" },
      "danger":      { "value": "#F2877F" },
      "warning":     { "value": "#E6CB78" },
      "scrim":       { "value": "rgba(0,0,0,0.55)" },
      "accent-tint": { "value": "rgba(134,160,242,0.35)" }
    }
  },
  "font": {
    "display": { "family": "Young Serif", "fallback": "Georgia, serif", "weights": [400], "use": "headings, scores" },
    "text":    { "family": "Figtree", "fallback": "system-ui, sans-serif", "weights": [400, 500, 600], "use": "everything else" },
    "numeric": "font-variant-numeric: tabular-nums for scores, counts and times"
  },
  "type-scale": {
    "display-l":  { "size": 40, "line": 1.1, "font": "display", "weight": 400, "tracking": "-0.01em", "use": "every title: screens, the wizard, the open posting, the run's summary" },
    "display-s":  { "size": 22, "line": 1.3, "font": "display", "weight": 400, "use": "every heading under a title: parts, steps, dialogs" },
    "score-l":    { "size": 56, "line": 1, "font": "display", "weight": 400, "use": "the score of the open posting" },
    "score-s":    { "size": 20, "line": 1, "font": "display", "weight": 400, "use": "scores in lists" },
    "body":       { "size": 14, "line": 1.5, "font": "text", "weight": 400 },
    "small":      { "size": 13, "line": 1.45, "font": "text", "weight": 400 },
    "label":      { "size": 12, "line": 1.4, "font": "text", "weight": 600, "tracking": "0.08em", "case": "uppercase", "color": "ink-muted" }
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": { "s": 4, "m": 8, "l": 10, "pill": 999 },
  "phone": {
    "$description": "Below the sidebar breakpoint (the phone app, #303): the same tokens, these sizes instead.",
    "type-scale": { "display-l": 36, "display-s": 19, "score-l": 48 },
    "tab-bar": { "icon": 22, "label": 11, "dash": { "width": 16, "height": 3 }, "bottom-inset": 22 },
    "action-bar": { "button-height": 48, "bottom-inset": 30 },
    "row-min-height": 72,
    "gutter": 20
  },
  "size": { "control-height": 44, "chip-height": 32, "sidebar-width": 220, "sidebar-breakpoint": 900, "screen-top": 40, "screen-gutter": 40, "gap-s": 6, "content-max-width": 760, "dash": { "width": 40, "height": 5 } },
  "shadow": { "page": "0 1px 2px rgba(30,26,22,0.08), 0 12px 32px rgba(30,26,22,0.08)" }
}
